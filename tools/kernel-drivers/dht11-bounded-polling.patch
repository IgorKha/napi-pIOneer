 #define DHT11_DATA_VALID_TIME	2000000000  /* 2s in ns */
 
 #define DHT11_EDGES_PREAMBLE 2
@@ -183,6 +187,49 @@
 	}
 
 	return IRQ_HANDLED;
+}
+
+/* Some GPIO controllers cannot capture DHT22's short pulses reliably via IRQ.
+ * Keep this opt-in fallback bounded; never sleep/log with interrupts disabled. */
+static int dht11_poll(struct dht11 *dht11)
+{
+	unsigned long flags;
+	s64 deadline, now;
+	int ret, value, previous = 1;
+	bool saw_high = false;
+
+	preempt_disable();
+	local_irq_save(flags);
+	ret = gpiod_direction_input(dht11->gpiod);
+	if (ret)
+		goto out;
+	deadline = ktime_get_boottime_ns() + 8000000;
+	while (dht11->num_edges < DHT11_EDGES_PER_READ) {
+		now = ktime_get_boottime_ns();
+		if (now >= deadline)
+			break;
+		value = gpiod_get_value(dht11->gpiod);
+		if (value < 0) {
+			ret = value;
+			goto out;
+		}
+		/* Skip the host's release; sensor frame starts on a falling edge. */
+		if (!saw_high) {
+			saw_high = value == 1;
+			continue;
+		}
+		if (value != previous) {
+			dht11->edges[dht11->num_edges].ts = now;
+			dht11->edges[dht11->num_edges++].value = value;
+			previous = value;
+		}
+		cpu_relax();
+	}
+	ret = dht11->num_edges == DHT11_EDGES_PER_READ ? 1 : 0;
+out:
+	local_irq_restore(flags);
+	preempt_enable();
+	return ret;
 }
 
